# Copia este archivo como ".env" (en la misma carpeta) y cambia los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Clave para firmar los tokens JWT. Tiene que ser larga y aleatoria.
# Para generar una:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
# Cuánto dura una sesión antes de pedir login de nuevo
JWT_EXPIRES_IN=8h

# Cuenta administradora: se crea sola al arrancar el backend
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave

# Correo (Gmail con "contraseña de aplicación") para verificación y pedidos
MAIL_USER=
MAIL_PASS=
MAIL_TO=

# Dominios que pueden llamar a la API, separados por coma
CORS_ORIGINS=http://localhost,http://127.0.0.1
# Dirección del frontend (se usa en el enlace del correo de verificación)
FRONTEND_URL=http://localhost
